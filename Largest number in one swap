class Solution {
    public String largestSwap(String s) {
        char[] arr = s.toCharArray();
        int n = arr.length;

        int[] last = new int[10];

        // store last position of each digit
        for(int i = 0; i < n; i++){
            last[arr[i] - '0'] = i;
        }

        for(int i = 0; i < n; i++){
            int curr = arr[i] - '0';

            // check if bigger digit exists later
            for(int d = 9; d > curr; d--){
                if(last[d] > i){
                    char temp = arr[i];
                    arr[i] = arr[last[d]];
                    arr[last[d]] = temp;
                    return new String(arr);
                }
            }
        }

        return s;
    }
}
