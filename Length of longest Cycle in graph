import java.util.*;

class Solution {
    
    int maxCycle = -1;

    public int longestCycle(int V, int[][] edges) {
        
        // Step 1: Build adjacency list
        ArrayList<ArrayList<Integer>> adj = new ArrayList<>();
        for (int i = 0; i < V; i++) {
            adj.add(new ArrayList<>());
        }
        
        for (int[] e : edges) {
            adj.get(e[0]).add(e[1]);
        }
        
        boolean[] visited = new boolean[V];
        boolean[] inStack = new boolean[V];
        int[] depth = new int[V];
        
        // Step 2: DFS from every node
        for (int i = 0; i < V; i++) {
            if (!visited[i]) {
                dfs(i, adj, visited, inStack, depth, 0);
            }
        }
        
        return maxCycle;
    }

    private void dfs(int node, ArrayList<ArrayList<Integer>> adj,
                     boolean[] visited, boolean[] inStack,
                     int[] depth, int d) {
        
        visited[node] = true;
        inStack[node] = true;
        depth[node] = d;
        
        for (int nei : adj.get(node)) {
            
            if (!visited[nei]) {
                dfs(nei, adj, visited, inStack, depth, d + 1);
            }
            
            // Cycle detected
            else if (inStack[nei]) {
                int cycleLen = d - depth[nei] + 1;
                maxCycle = Math.max(maxCycle, cycleLen);
            }
        }
        
        inStack[node] = false; // backtrack
    }
}
