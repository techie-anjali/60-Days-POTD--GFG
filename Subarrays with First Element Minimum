import java.util.*;

class Solution {
    public int countSubarrays(int[] arr) {

        int n = arr.length;
        int ans = 0;

        Stack<Integer> st = new Stack<>();

        for(int i = 0; i < n; i++){

            while(!st.isEmpty() && arr[st.peek()] > arr[i]){
                int idx = st.pop();
                ans += i - idx;
            }

            st.push(i);
        }

        while(!st.isEmpty()){
            int idx = st.pop();
            ans += n - idx;
        }

        return ans;
    }
}
