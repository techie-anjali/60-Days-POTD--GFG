class Solution {
    public ArrayList<Integer> minHeightRoot(int V, int[][] edges) {
        
        ArrayList<Integer> ans = new ArrayList<>();
        
        // Edge case
        if (V == 1) {
            ans.add(0);
            return ans;
        }

        // Step 1: Build graph
        ArrayList<HashSet<Integer>> graph = new ArrayList<>();
        for (int i = 0; i < V; i++) {
            graph.add(new HashSet<>());
        }

        for (int[] e : edges) {
            int u = e[0];
            int v = e[1];
            graph.get(u).add(v);
            graph.get(v).add(u);
        }

        // Step 2: Find leaves
        Queue<Integer> q = new LinkedList<>();
        for (int i = 0; i < V; i++) {
            if (graph.get(i).size() == 1) {
                q.offer(i);
            }
        }

        int remaining = V;

        // Step 3: Trim leaves
        while (remaining > 2) {
            int size = q.size();
            remaining -= size;

            for (int i = 0; i < size; i++) {
                int leaf = q.poll();

                for (int nei : graph.get(leaf)) {
                    graph.get(nei).remove(leaf);

                    if (graph.get(nei).size() == 1) {
                        q.offer(nei);
                    }
                }
            }
        }

        // Step 4: Remaining nodes = answer
        ans.addAll(q);

        return ans;
    }
}
