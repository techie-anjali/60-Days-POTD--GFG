frequency array 
Time Complexity: O(n + max(arr[i])^2)
Auxiliary Space: O(max(arr[i]))

class Solution {
    boolean pythagoreanTriplet(int[] arr) {
        
        int max = 0;
        for(int x : arr){
            max = Math.max(max, x);
        }
        
        boolean[] freq = new boolean[max + 1];
        
        for(int x : arr){
            freq[x] = true;
        }
        
        for(int a = 1; a <= max; a++){
            if(!freq[a]) continue;
            
            for(int b = a+1; b <= max; b++){
                if(!freq[b]) continue;
                
                int sum = a*a + b*b;
                int c = (int)Math.sqrt(sum);
                
                if(c <= max && c*c == sum && freq[c]){
                    return true;
                }
            }
        }
        
        return false;
    }
}

