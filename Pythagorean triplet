1️⃣ Sorting + Two Pointer Approach

Steps:Square elements → O(n); Sort array → O(n log n)
Two pointer search → O(n²)

✔ Total TC:O(n2)
✔ Space: O(1)


code : 
class Solution {
    boolean pythagoreanTriplet(int[] arr) {
        
        int n = arr.length;
       
        for(int i = 0; i < n; i++){
            arr[i] = arr[i] * arr[i];
        }
        
        Arrays.sort(arr);
        
        // choose c²
        for(int i = n-1; i >= 2; i--){
            
            int left = 0;
            int right = i-1;
            
            while(left < right){
                
                int sum = arr[left] + arr[right];
                
                if(sum == arr[i]){
                    return true;
                }
                else if(sum < arr[i]){
                    left++;
                }
                else{
                    right--;
                }
            }
        }
        
        return false;
    }
}

