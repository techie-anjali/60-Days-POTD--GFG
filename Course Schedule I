mport java.util.*;

class Solution {
    public boolean canFinish(int n, int[][] prerequisites) {
        
        // Step 1: indegree array
        int[] indegree = new int[n];

        // Step 2: adjacency matrix (array only)
        int[][] adj = new int[n][n];

        // Build graph
        for(int i = 0; i < prerequisites.length; i++) {
            int x = prerequisites[i][0];
            int y = prerequisites[i][1];

            adj[y][x] = 1;  // edge y → x
            indegree[x]++;
        }

        // Step 3: queue
        Queue<Integer> q = new LinkedList<>();
        for(int i = 0; i < n; i++) {
            if(indegree[i] == 0) {
                q.add(i);
            }
        }

        // Step 4: process
        int count = 0;

        while(!q.isEmpty()) {
            int node = q.poll();
            count++;

            // check all neighbors using array
            for(int i = 0; i < n; i++) {
                if(adj[node][i] == 1) {
                    indegree[i]--;
                    if(indegree[i] == 0) {
                        q.add(i);
                    }
                }
            }
        }

        return count == n;
    }
}
