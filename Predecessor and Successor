
import java.util.*;

class Solution {
    public ArrayList<Node> findPreSuc(Node root, int key) {
        Node pre = null, suc = null;
        Node curr = root;

        while (curr != null) {
            if (curr.data < key) {
                pre = curr;
                curr = curr.right;
            } 
            else if (curr.data > key) {
                suc = curr;
                curr = curr.left;
            } 
            else {
                Node temp = curr.left;
                while (temp != null) {
                    pre = temp;
                    temp = temp.right;
                }

                temp = curr.right;
                while (temp != null) {
                    suc = temp;
                    temp = temp.left;
                }
                break;
            }
        }

        ArrayList<Node> res = new ArrayList<>();
        res.add(pre);
        res.add(suc);
        return res;
    }
}
