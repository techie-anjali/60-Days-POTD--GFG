class Solution {
    public long sumAndMultiply(int n) {
        int num = n;
        int rev = 0;
        int sum = 0;

        // Build reversed number using only non-zero digits
        while (num > 0) {
            int dig = num % 10;

            if (dig != 0) {
                rev = rev * 10 + dig;
                sum += dig;
            }

            num /= 10;
        }

        // Reverse again to get digits in original order
        int x = 0;
        while (rev > 0) {
            int dig = rev % 10;
            x = x * 10 + dig;
            rev /= 10;
        }

        return (long) x * sum;
    }
}
